{
    "project": {
        "framework": "nest.js",
        "name": "Raven Project",
        "outDir": "src",
        "debugger": true
    },
    "schema": {
        "tables": {
            "user": {
                "firstName": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "maxLength": 25
                    }
                },
                "lastName": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "maxLength": 25
                    }
                },
                "avatar": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isUrl": true
                    }
                }
            },
            "business": {
                "name": {
                    "type": "string",
                    "description": "",
                    "default": "",
                    "validations": {
                        "isRequired": true,
                        "maxLength": 50
                    }
                },
                "subdomain": {
                    "type": "string",
                    "description": "",
                    "default": "",
                    "validations": {
                        "isRequired": true,
                        "isUnique": true,
                        "maxLength": 25
                    }
                },
                "location": {
                    "type": "string",
                    "description": "",
                    "default": "",
                    "validations": {
                        "isRequired": true,
                        "isLatLong": true
                    }
                },
                "slogan": {
                    "type": "string",
                    "description": "",
                    "default": "",
                    "validations": {
                        "maxLength": 100
                    }
                },
                "brief": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "maxLength": 500
                    }
                },
                "logo": {
                    "type": "string",
                    "description": "",
                    "default": "",
                    "validations": {
                        "isUrl": true,
                        "isRequired": true
                    }
                },
                "tier": {
                    "type": "enum",
                    "description": "",
                    "default": "essentials",
                    "validations": {
                        "enum": "businessTier"
                    }
                },
                "status": {
                    "type": "enum",
                    "description": "",
                    "validations": {
                        "enum": "businessStatus"
                    }
                },
                "theme": {
                    "type": "enum",
                    "description": "",
                    "validations": {
                        "enum": "websiteTheme"
                    }
                },
                "wifiPass": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "maxLength": 100
                    }
                },
                "phoneNumber": {
                    "type": "string",
                    "description": "",
                    "default": "",
                    "validations": {
                        "maxLength": 100,
                        "isPhoneNumber": true
                    }
                },
                "publicPhone": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "maxLength": 100,
                        "isPhoneNumber": true
                    }
                },
                "instagram": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isUrl": true
                    }
                },
                "facebook": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isUrl": true
                    }
                },
                "whatsapp": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "maxLength": 100,
                        "isPhoneNumber": true
                    }
                }
            },
            "item": {
                "name": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "maxLength": 25
                    }
                },
                "price": {
                    "type": "number",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "isDecimal": true,
                        "min": 0
                    }
                },
                "description": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "maxLength": 1000
                    }
                },
                "image": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isUrl": true,
                        "isRequired": true
                    }
                },
                "quantity": {
                    "type": "number",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "isInteger": true,
                        "min": 0
                    }
                }
            },
            "collection": {
                "name": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "maxLength": 25
                    }
                }
            },
            "testimonial": {
                "content": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "maxLength": 25
                    }
                },
                "status": {
                    "type": "enum",
                    "description": "",
                    "validations": {
                        "enum": "businessStatus"
                    }
                }
            },
            "discount": {
                "percent": {
                    "type": "number",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "isPercentage": true,
                        "min": 0,
                        "max": 1
                    }
                }
            },
            "coupon": {
                "code": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "maxLength": 25
                    }
                },
                "percent": {
                    "type": "number",
                    "description": "",
                    "validations": {
                        "isPercentage": true,
                        "min": 0,
                        "max": 1
                    }
                },
                "amount": {
                    "type": "number",
                    "description": "",
                    "validations": {
                        "isDecimal": true,
                        "min": 0
                    }
                }
            },
            "review": {
                "comment": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "minLength": 0,
                        "maxLength": 1000
                    }
                },
                "rating": {
                    "type": "number",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "isInteger": true,
                        "min": 1,
                        "max": 5
                    }
                },
                "image": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isUrl": true,
                        "isRequired": true
                    }
                }
            },
            "order": {
                "status": {
                    "type": "enum",
                    "description": "",
                    "validations": {
                        "enum": "orderStatus"
                    }
                },
                "totalPrice": {
                    "type": "number",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "isDecimal": true,
                        "min": 0
                    }
                }
            },
            "orderItem": {
                "quantity": {
                    "type": "number",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "isInteger": true,
                        "min": 0
                    }
                }
            },
            "caramel": {
                "identifier": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "isUnique": true,
                        "maxLength": 30
                    }
                },
                "content": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isRequired": true
                    }
                }
            },
            "availabilitySlot": {
                "day": {
                    "type": "enum",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "enum": "day"
                    }
                },
                "startTime": {
                    "type": "date",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "isDate": true
                    }
                },
                "endTime": {
                    "type": "date",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "isDate": true
                    }
                }
            },
            "teamMember": {
                "name": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "maxLength": 25
                    }
                },
                "image": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isUrl": true,
                        "isRequired": true
                    }
                },
                "brief": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "maxLength": 1000
                    }
                },
                "role": {
                    "type": "string",
                    "description": "",
                    "validations": {
                        "isRequired": true,
                        "maxLength": 50
                    }
                }
            }
        },
        "relations": [
            "user<>business",
            "user>testimonial",
            "user>review",
            "user>order",
            "user>orderItem",
            "business>item",
            "business>collection",
            "business>testimonial",
            "business>discount",
            "business>coupon",
            "business>review",
            "business>order",
            "business>orderItem",
            "business>availabilitySlot",
            "business>teamMember",
            "collection>item",
            "item-discount",
            "item>review",
            "item>orderItem",
            "coupon>order",
            "order>orderItem"
        ],
        "enums": {
            "userRole": ["admin", "owner", "employee", "customer"],
            "businessTier": ["essentials", "professional", "elite", "royal"],
            "businessStatus": ["pending", "active", "restricted"],
            "websiteTheme": ["modern", "classic", "nature"],
            "orderStatus": ["pending", "received"],
            "testimonialStatus": ["pending", "approved"],
            "day": [
                "saturday",
                "sunday",
                "monday",
                "tuesday",
                "wednesday",
                "thursday",
                "friday"
            ]
        }
    },
    "services": {
        "mailer": true,
        "aws": true
    },
    "env": {
        "swagger": {
            "allowedUrls": "FRONTEND_URLS",
            "url": "ENVIRONMENT",
            "port": "PORT"
        },
        "jwt": {
            "secret": "JWT_SECRET"
        },
        "database": {
            "host": "DATABASE_HOST",
            "port": "DATABASE_PORT",
            "user": "POSTGRES_USER",
            "password": "POSTGRES_PASSWORD",
            "name": "POSTGRES_DB"
        },
        "mailer": {
            "email": "OFFICIAL_EMAIL",
            "password": "OFFICIAL_EMAIL_PASSWORD",
            "provider": "MAILER_SERVICE_PROVIDER"
        },
        "aws": {
            "accessKey": "AWS_ACCESS_KEY",
            "secretKey": "AWS_SECRET_ACCESS_KEY",
            "region": "AWS_REGION",
            "bucketName": "S3_BUCKET_NAME"
        }
    }
}
